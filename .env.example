# Base de donnees PostgreSQL (Railway fournit DATABASE_URL automatiquement)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Auth.js — generer avec: openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire-de-32-octets"
AUTH_TRUST_HOST="true"

# URL publique de l'application (Railway: https://<service>.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"

# Interfaçage FNE — "mock" (simulateur local, défaut) ou "live" (appels réels DGI)
FNE_MODE="mock"
# FNE_BASE_URL="http://54.247.95.108/ws"
# FNE_API_KEY="clé délivrée par la DGI après validation des spécimens"

# Rejoue le seed de démonstration en pré-déploiement.
# À n'activer qu'au tout premier déploiement, puis à repasser à false.
SEED_ON_DEPLOY="false"
